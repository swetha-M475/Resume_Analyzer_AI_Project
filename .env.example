# OpenRouter (Recommended - Fast, reliable, no harsh rate limits)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Model choice (Default: meta-llama/llama-3.3-70b-instruct:free)
# Alternatives: deepseek/deepseek-chat, google/gemini-2.0-flash-exp:free, mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Fallback LLM options (optional)
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here
